# Formal proof of the PinV pin/timing unit.
#   yowasp-sby -f pinv_io.sby        (or: sby -f pinv_io.sby)
[tasks]
prove
cover

[options]
prove: mode prove
prove: depth 4
cover: mode cover
cover: depth 12

[engines]
smtbmc z3

[script]
read -formal -DPINV_IO_FORMAL pinv_io.v
prep -top pinv_io

[files]
../src/pinv_io.v
pinv_io_props.vh
