# Formal proof of the PinV top level (loading and core reset). PicoRV32 and the
# pin/timing unit are replaced by stand-ins whose outputs are completely free
# (picorv32_free.v, pinv_io_free.v), which over-approximates both; the unit is
# proven on its own in pinv_io.sby; the memory is reduced to 4 words,
# since the properties do not depend on its size.
[tasks]
prove
cover

[options]
prove: mode prove
prove: depth 4
cover: mode cover
cover: depth 12

[engines]
smtbmc yices

[script]
read -formal pinv_io_free.v pinv_loader.v picorv32_free.v
read -formal -DPINV_TOP_FORMAL project.v
chparam -set MEM_WORDS 4 tt_um_edoouuard_protoemu
prep -top tt_um_edoouuard_protoemu

[files]
../src/project.v
pinv_io_free.v
../src/pinv_loader.v
picorv32_free.v
top_props.vh
