# Formal proof of the PinV pin/timing unit, in two independent groups of
# properties (each proven without assuming the other):
#   core:  timing contract (zero jitter, exact outputs, deadline, shifts, reset)
#   bound: bounded waits, timeout flag, limit register, lock request
#   make -C formal pinv_io
[tasks]
core
bound
cover

[options]
core: mode prove
core: depth 3
bound: mode prove
bound: depth 3
cover: mode cover
cover: depth 12

[engines]
smtbmc yices

[script]
core: read -formal -DPINV_IO_FORMAL -DPROPS_CORE pinv_io.v
bound: read -formal -DPINV_IO_FORMAL -DPROPS_BOUND pinv_io.v
cover: read -formal -DPINV_IO_FORMAL pinv_io.v
prep -top pinv_io

[files]
../src/pinv_io.v
pinv_io_props.vh
